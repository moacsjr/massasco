# Provider binaries and cache
.terraform/

# State files (contain sensitive data — use remote backend in production)
terraform.tfstate
terraform.tfstate.backup

# Variable overrides (may contain secrets)
*.tfvars
*.tfvars.json
!example.tfvars

# Crash logs
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json
