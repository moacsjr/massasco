# Local-development env. Copy to `.env` and fill in.
# Production values are set as Amplify environment variables (terraform/amplify.tf);
# do NOT commit a real `.env`.

DATABASE_URL="postgresql://postgres:password@localhost:5432/devxp?schema=public"

# Stripe Configuration (Get these from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Optional — set when developing the media-upload flow:
# NEXT_PUBLIC_CDN_URL="https://<cloudfront-domain>"
# S3_MEDIA_BUCKET_NAME="<bucket>"
