# Hoist all prisma-related packages and subdependencies to the top level
# so the prisma CLI can resolve them in strict pnpm mode
public-hoist-pattern[]=*prisma*
# Hoist Next.js and its internal deps (styled-jsx, etc.) to avoid
# "Cannot find module 'styled-jsx/package.json'" at runtime
public-hoist-pattern[]=*next*
public-hoist-pattern[]=styled-jsx
