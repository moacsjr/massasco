generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// Order Management System Models
// ============================================================================

model Category {
  id          String    @id @default(uuid())
  name        String
  description String?
  imageUrl    String?
  products    Product[]
  createdAt   DateTime  @default(now())
}

model Product {
  id          String        @id @default(uuid())
  name        String
  description String?
  imageUrl    String?
  categoryId  String
  category    Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  prices      ProductPrice[]
  complements ProductComplement[]
  orderItems  OrderItem[]
  createdAt   DateTime      @default(now())
}

model ProductPrice {
  id          String   @id @default(uuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  description String
  value       Decimal  @db.Decimal(10, 2)
  orderItems  OrderItem[]
  createdAt   DateTime @default(now())
}

model ProductComplement {
  id          String   @id @default(uuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  group       String
  title       String
  description String?
  value       Decimal  @db.Decimal(10, 2) @default(0)
  createdAt   DateTime @default(now())
}

// ============================================================================
// Order Model - Represents an order placed during a table session
// ============================================================================

model Order {
  id             String        @id @default(uuid())
  checkInId      String?
  checkIn        CheckIn?      @relation(fields: [checkInId], references: [id], onDelete: SetNull)
  tableSessionId String?
  tableSession   TableSession? @relation(fields: [tableSessionId], references: [id], onDelete: SetNull)
  tableNumber    Int
  customerName   String
  status         OrderStatus   @default(OPEN)
  items          OrderItem[]
  payments       Payment[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

// ============================================================================
// CheckIn Model - DEPRECATED: Represents a customer session at a table
// This model is kept for backward compatibility during migration
// ============================================================================

model CheckIn {
  id           String        @id @default(uuid())
  tableNumber  Int
  customerName String
  status       CheckInStatus @default(OPEN)
  createdAt    DateTime      @default(now())
  closedAt     DateTime?

  orders       Order[]
  payments     Payment[]

  @@unique([tableNumber, status]) // Only one OPEN check-in per table
}

enum CheckInStatus {
  OPEN
  CLOSED
}

model OrderItem {
  id                  String      @id @default(uuid())
  orderId             String
  order               Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId           String
  product             Product     @relation(fields: [productId], references: [id])
  quantity            Int         @default(1)
  notes               String?
  status              ItemStatus  @default(PENDING)
  selectedPriceId     String?
  selectedPrice       ProductPrice? @relation(fields: [selectedPriceId], references: [id])
  selectedComplements Json?       // Array of { id, title, value }
  sentAt              DateTime?
  deliveredAt         DateTime?
  createdAt           DateTime    @default(now())
}

model Payment {
  id             String   @id @default(uuid())
  orderId        String?  // Nullable - payments can be against Order
  checkInId      String?  // Nullable - payments can be against CheckIn
  tableSessionId String?  // Nullable - payments can be against TableSession
  order          Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  checkIn        CheckIn? @relation(fields: [checkInId], references: [id], onDelete: SetNull)
  tableSession   TableSession? @relation(fields: [tableSessionId], references: [id], onDelete: SetNull)
  amount         Decimal  @db.Decimal(10, 2)
  method         String   // cash, card, pix
  createdAt      DateTime @default(now())
}

// ============================================================================
// Table Management System Models
// ============================================================================

model Table {
  id               String              @id @default(uuid())
  number           Int                 @unique
  name             String?
  isActive         Boolean             @default(true)
  token            String              @unique @default(uuid())
  qrCodeUrl        String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  sessions         TableSession[]
  tableAccessTokens TableAccessToken[]

  @@map("tables")
}

model TableAccessToken {
  id           String    @id @default(uuid())
  tableId      String
  table        Table     @relation(fields: [tableId], references: [id], onDelete: Cascade)
  token        String    @unique
  isActive     Boolean   @default(true)
  revoked      Boolean   @default(false)
  revokedAt    DateTime?
  revokedBy    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("table_access_tokens")
}

model TableSession {
  id             String              @id @default(uuid())
  tableId        String
  table          Table               @relation(fields: [tableId], references: [id], onDelete: Cascade)
  hostName       String
  status         TableSessionStatus  @default(OPEN)
  capacity       Int                 @default(1)
  createdAt      DateTime            @default(now())
  closedAt       DateTime?
  closedBy       String?

  participants   Participant[]
  orders         Order[]
  payments       Payment[]
  joinRequests   ParticipantJoinRequest[]

  @@map("table_sessions")
}

model Participant {
  id             String        @id @default(uuid())
  tableSessionId String
  tableSession   TableSession  @relation(fields: [tableSessionId], references: [id], onDelete: Cascade)
  name           String
  email          String?
  phone          String?
  status         ParticipantStatus @default(PENDING)
  joinedAt       DateTime?
  approvedAt     DateTime?
  approvedBy     String?
  rejectedAt     DateTime?
  rejectedBy     String?
  role           ParticipantRole @default(GUEST)
  deviceSessions DeviceSession[]

  @@map("participants")
}

model DeviceSession {
  id            String       @id @default(uuid())
  participantId String
  participant   Participant  @relation(fields: [participantId], references: [id], onDelete: Cascade)
  sessionId     String       @unique
  deviceInfo    Json?
  ipaddress     String?
  location      Json?
  expiresAt     DateTime
  createdAt     DateTime     @default(now())
  lastActive    DateTime     @updatedAt

  @@map("device_sessions")
}

model ParticipantJoinRequest {
  id             String        @id @default(uuid())
  tableSessionId String
  tableSession   TableSession  @relation(fields: [tableSessionId], references: [id], onDelete: Cascade)
  requesterName  String
  requesterEmail String?
  status         JoinRequestStatus @default(PENDING)
  ipAddress      String?
  deviceInfo     Json?
  requestedAt    DateTime      @default(now())
  respondedAt    DateTime?
  respondedBy    String?
  responseMessage String?

  @@map("participant_join_requests")
}

model AuditLog {
  id           String   @id @default(uuid())
  entityType   String?
  entityId     String?
  action       String
  performedBy  String?
  metadata     Json?
  createdAt    DateTime @default(now())

  @@map("audit_logs")
}

// ============================================================================
// System Settings Model
// ============================================================================

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("system_settings")
}

enum OrderStatus {
  OPEN
  AWAITING_PAYMENT
  PAID
  CLOSED
}

enum ItemStatus {
  PENDING
  PREPARING
  READY
  DELIVERED
  CANCELLED
}

enum TableSessionStatus {
  OPEN
  OCCUPIED
  CLOSING
  CLOSED
}

enum ParticipantStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum ParticipantRole {
  HOST
  GUEST
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}
