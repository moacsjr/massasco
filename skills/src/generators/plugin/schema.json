{
  "$schema": "http://json-schema.org/schema",
  "$id": "Plugin",
  "title": "Gerador de Plugin",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome do plugin (ex: auth, kubernetes, catalog)",
      "$default": {
        "$source": "argv",
        "index": 0
      }
    }
  },
  "required": ["name"]
}
